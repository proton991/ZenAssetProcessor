include_guard(GLOBAL)
include(${CMAKE_CURRENT_LIST_DIR}/ReaderSourceHashes.cmake)
set(ZENASSET_READER_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../third_party/reader")

# An empty prefix verifies the complete bundle. A component prefix verifies the
# same files in its pristine upstream tree when Processor fetches that tree.
function(zenasset_verify_reader_sources root prefix)
    foreach(entry IN LISTS ZENASSET_READER_SOURCE_HASHES)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 expected)
        list(GET fields 1 relative)
        string(FIND "${relative}" "${prefix}" position)
        if(position EQUAL 0)
            string(LENGTH "${prefix}" prefix_length)
            string(SUBSTRING "${relative}" ${prefix_length} -1 relative)
            set(path "${root}/${relative}")
            if(NOT EXISTS "${path}")
                message(FATAL_ERROR "Pinned reader source is missing: ${path}")
            endif()
            file(SHA256 "${path}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Pinned reader source changed: ${path}. Review the decoder export and source hash manifest.")
            endif()
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        endif()
    endforeach()
endfunction()

zenasset_verify_reader_sources("${ZENASSET_READER_SOURCE_DIR}" "")
