option(ZENASSET_BUILD_FUZZER "Build the Clang libFuzzer/AddressSanitizer reader harness" OFF)
if(ZENASSET_BUILD_FUZZER)
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR NOT CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
        message(FATAL_ERROR "ZENASSET_BUILD_FUZZER requires Clang's clang++ driver and libFuzzer runtime")
    endif()
    if(ZENASSET_BUILD_PROCESSOR)
        message(FATAL_ERROR "Use a separate reader-only build for ZENASSET_BUILD_FUZZER")
    endif()
    if(WIN32 AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded")
        message(FATAL_ERROR "The Windows libFuzzer runtime requires -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded")
    endif()
    foreach(target ZenAssetFormat ZenAssetReader ZenAssetZstdDecoder ZenAssetMeshoptDecoder ZenAssetBlockDecoder)
        target_compile_options(${target} PRIVATE -fsanitize=fuzzer-no-link,address -fno-omit-frame-pointer)
    endforeach()
    target_compile_options(ZenAssetFormat INTERFACE -fsanitize=address)
    target_link_options(ZenAssetFormat INTERFACE -fsanitize=address)
    if(WIN32)
        # The packaged libFuzzer runtime uses the MSVC STL without container
        # annotations. Match its ABI; ordinary ASan allocation checks stay active.
        target_compile_definitions(ZenAssetFormat PUBLIC _DISABLE_STRING_ANNOTATION _DISABLE_VECTOR_ANNOTATION)
    endif()
    add_executable(ZenAssetReaderFuzz tests/fuzz/ReaderFuzz.cpp)
    target_link_libraries(ZenAssetReaderFuzz PRIVATE ZenAssetReader)
    target_include_directories(ZenAssetReaderFuzz PRIVATE src)
    target_compile_options(ZenAssetReaderFuzz PRIVATE -fsanitize=fuzzer,address -fno-omit-frame-pointer)
    target_link_options(ZenAssetReaderFuzz PRIVATE -fsanitize=fuzzer,address)
endif()
