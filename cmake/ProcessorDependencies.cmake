include(FetchContent)
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()
include(${CMAKE_CURRENT_LIST_DIR}/ObjDependencies.cmake)

# Existing target names are reused when embedded in a larger build. Otherwise
# dependencies are fetched using verified archives; no engine checkout is used.
function(zenasset_processor_dependencies)
    zenasset_obj_dependencies()
    # Scope dependency configuration to this call. An embedded reader/runtime
    # build must not enable parser installation in the parent project.
    set(BUILD_SHARED_LIBS OFF)
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(SIMDJSON_DEVELOPER_MODE OFF CACHE BOOL "Build simdjson developer tools")
    set(SIMDJSON_INSTALL ${ZENASSET_INSTALL_PROCESSOR})
    set(FASTGLTF_ENABLE_TESTS OFF CACHE BOOL "Build fastgltf tests")
    set(FASTGLTF_ENABLE_EXAMPLES OFF CACHE BOOL "Build fastgltf examples")
    set(FASTGLTF_ENABLE_DOCS OFF CACHE BOOL "Build fastgltf docs")
    set(FASTGLTF_ENABLE_INSTALL ${ZENASSET_INSTALL_PROCESSOR})
    set(DRACO_TESTS OFF CACHE BOOL "Build Draco tests")
    set(DRACO_INSTALL ${ZENASSET_INSTALL_PROCESSOR})
    set(DRACO_JS_GLUE OFF CACHE BOOL "Build Draco JS")
    set(MESHOPT_BUILD_DEMO OFF CACHE BOOL "Build meshoptimizer demo")
    set(MESHOPT_BUILD_GLTFPACK OFF CACHE BOOL "Build gltfpack")
    set(MESHOPT_INSTALL ${ZENASSET_INSTALL_PROCESSOR})
    foreach(tool ANIM_UTILS CWEBP DWEBP GIF2WEBP IMG2WEBP VWEBP WEBPINFO LIBWEBPMUX WEBPMUX EXTRAS)
        set(WEBP_BUILD_${tool} OFF CACHE BOOL "Build WebP tools")
    endforeach()

    if(NOT TARGET simdjson)
        FetchContent_Declare(simdjson URL https://codeload.github.com/simdjson/simdjson/zip/refs/tags/v4.6.11
            URL_HASH SHA256=5a3bc470d53b0324dfcbef952fdbd004655d7a4f7a6558fb94122cb9f233f2d0)
        FetchContent_MakeAvailable(simdjson)
    endif()
    if(NOT TARGET fastgltf)
        FetchContent_Declare(fastgltf URL https://codeload.github.com/spnda/fastgltf/zip/refs/tags/v0.9.1
            URL_HASH SHA256=fb3bd2421064cd4d9ec0a774c643c0e174595337dc06ba75b73ec73542caba2d)
        FetchContent_MakeAvailable(fastgltf)
    endif()
    if(NOT TARGET draco::draco)
        FetchContent_Declare(draco URL https://codeload.github.com/google/draco/zip/refs/tags/1.5.7
            URL_HASH SHA256=27b72ba2d5ff3d0a9814ad40d4cb88f8dc89a35491c0866d952473f8f9416b77)
        FetchContent_MakeAvailable(draco)
    else()
        FetchContent_GetProperties(draco SOURCE_DIR draco_SOURCE_DIR)
    endif()
    if(NOT TARGET meshoptimizer)
        FetchContent_GetProperties(meshoptimizer SOURCE_DIR meshoptimizer_source BINARY_DIR meshoptimizer_binary)
        add_subdirectory(${meshoptimizer_source} ${meshoptimizer_binary})
    endif()
    if(NOT TARGET webpdecoder)
        FetchContent_Declare(libwebp URL https://codeload.github.com/webmproject/libwebp/zip/refs/tags/v1.6.0
            URL_HASH SHA256=7a89bb7a6a0c30b5c0f521c2673635381b4e7c916585f4a1f702d3b47f15d5e5)
        FetchContent_MakeAvailable(libwebp)
    else()
        FetchContent_GetProperties(libwebp SOURCE_DIR libwebp_SOURCE_DIR)
    endif()
    if(TARGET zen_ufbx)
        add_library(ZenAssetUfbx ALIAS zen_ufbx)
    else()
        FetchContent_Declare(ufbx URL https://codeload.github.com/ufbx/ufbx/zip/refs/tags/v0.23.1
            URL_HASH SHA256=3e5d8219f5b634fd374949808206eba1a1da49b2b2e3ee31ff0bd228c0abd469 SOURCE_SUBDIR zenasset-no-cmake)
        FetchContent_MakeAvailable(ufbx)
        add_library(ZenAssetUfbx STATIC ${ufbx_SOURCE_DIR}/ufbx.c)
        target_include_directories(ZenAssetUfbx PUBLIC
            $<BUILD_INTERFACE:${ufbx_SOURCE_DIR}>
            $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/ZenAsset/Dependencies/ufbx>)
        set_target_properties(ZenAssetUfbx PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME PrivateUfbx)
    endif()
    # Own this wrapper even in an embedded build: a parent's Basis target may
    # embed its bundled zstd implementation and duplicate our runtime decoder.
    FetchContent_Declare(basis_universal URL https://codeload.github.com/BinomialLLC/basis_universal/zip/refs/tags/v1_60
        URL_HASH SHA256=f79c13343ddab36f3d37629775b9ca8e2fbf55a758d505e2150a8b7faee17d2a SOURCE_SUBDIR zenasset-no-cmake)
    FetchContent_MakeAvailable(basis_universal)
    add_library(ZenAssetBasis STATIC ${basis_universal_SOURCE_DIR}/transcoder/basisu_transcoder.cpp)
    target_link_libraries(ZenAssetBasis PRIVATE ZenAssetZstdDecoder)
    target_include_directories(ZenAssetBasis PUBLIC $<BUILD_INTERFACE:${basis_universal_SOURCE_DIR}/transcoder>)
    target_compile_definitions(ZenAssetBasis PUBLIC BASISD_SUPPORT_KTX2_ZSTD=1)
    set_target_properties(ZenAssetBasis PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME PrivateBasis)
    if(TARGET stb)
        add_library(ZenAssetStb ALIAS stb)
    else()
        FetchContent_Declare(stb URL https://codeload.github.com/nothings/stb/zip/2c980bb59875b0d32144a71867fbdebb2f77cd20
            URL_HASH SHA256=8e59f72b0780690cda64726804269f638a3be77b9d1506ea95f443f7964bccf0 SOURCE_SUBDIR zenasset-no-cmake)
        FetchContent_MakeAvailable(stb)
        add_library(ZenAssetStb INTERFACE)
        target_include_directories(ZenAssetStb INTERFACE $<BUILD_INTERFACE:${stb_SOURCE_DIR}>)
        set_target_properties(ZenAssetStb PROPERTIES EXPORT_NAME PrivateStb)
    endif()
    if(ZENASSET_INSTALL_PROCESSOR)
        foreach(dependency simdjson fastgltf draco meshoptimizer libwebp ufbx basis_universal stb zenasset_tinyobj zenasset_earcut)
            FetchContent_GetProperties(${dependency} SOURCE_DIR dependency_source)
            if(NOT dependency_source OR NOT IS_DIRECTORY "${dependency_source}")
                message(FATAL_ERROR "Installing Processor requires its pinned ${dependency} sources. Configure a standalone build, or disable ZENASSET_INSTALL_PROCESSOR when embedding existing targets.")
            endif()
            set(ZENASSET_DEPENDENCY_${dependency}_SOURCE "${dependency_source}" PARENT_SCOPE)
        endforeach()
    endif()
    set(ZENASSET_DECODER_INCLUDE_DIRS ${draco_SOURCE_DIR}/src ${libwebp_SOURCE_DIR}/src ${CMAKE_BINARY_DIR} PARENT_SCOPE)
endfunction()
