# Export the reviewed runtime subset from the hash-verified upstream trees.
# The output must be new. Review the generated manifest when updating pins.
cmake_minimum_required(VERSION 3.23)
foreach(variable MESHOPT_SOURCE_DIR ZSTD_SOURCE_DIR OUTPUT_DIRECTORY)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        message(FATAL_ERROR "ExportReaderSources requires ${variable}")
    endif()
endforeach()
if(EXISTS "${OUTPUT_DIRECTORY}")
    message(FATAL_ERROR "OUTPUT_DIRECTORY must not already exist")
endif()
include(${CMAKE_CURRENT_LIST_DIR}/../cmake/MeshoptExtraction.cmake)

set(meshopt "${OUTPUT_DIRECTORY}/meshoptimizer")
zenasset_generate_meshopt_decoders("${MESHOPT_SOURCE_DIR}" "${meshopt}")

# Preserve the upstream files byte for byte. Headers retain upstream public and
# shared declarations; no compressor, dictionary builder, legacy or ASM source
# is included. The library compiles the same twelve C files in every build mode.
file(GLOB zstd_headers RELATIVE "${ZSTD_SOURCE_DIR}"
    "${ZSTD_SOURCE_DIR}/lib/common/*.h" "${ZSTD_SOURCE_DIR}/lib/decompress/*.h")
set(zstd_files ${zstd_headers}
    LICENSE COPYING lib/zstd.h lib/zstd_errors.h
    lib/common/debug.c lib/common/entropy_common.c lib/common/error_private.c
    lib/common/fse_decompress.c lib/common/pool.c lib/common/threading.c
    lib/common/xxhash.c lib/common/zstd_common.c
    lib/decompress/huf_decompress.c lib/decompress/zstd_ddict.c
    lib/decompress/zstd_decompress_block.c lib/decompress/zstd_decompress.c)
foreach(relative IN LISTS zstd_files)
    get_filename_component(parent "${OUTPUT_DIRECTORY}/zstd/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${ZSTD_SOURCE_DIR}/${relative}" "${OUTPUT_DIRECTORY}/zstd/${relative}")
endforeach()

file(GLOB_RECURSE files RELATIVE "${OUTPUT_DIRECTORY}" "${OUTPUT_DIRECTORY}/*")
list(SORT files)
set(manifest "# Generated by tools/ExportReaderSources.cmake from the pinned codec sources.\nset(ZENASSET_READER_SOURCE_HASHES\n")
foreach(relative IN LISTS files)
    file(SHA256 "${OUTPUT_DIRECTORY}/${relative}" hash)
    string(APPEND manifest "    \"${hash}|${relative}\"\n")
endforeach()
string(APPEND manifest ")\n")
file(WRITE "${OUTPUT_DIRECTORY}/ReaderSourceHashes.cmake" "${manifest}")
message(STATUS "Exported reader sources and review manifest to ${OUTPUT_DIRECTORY}")
